$ModuleName = "PCBuild-Module"
$ModuleDir = "$($env:ProgramFiles)\WindowsPowerShell\Modules\$($ModuleName)"
if (!(Test-Path $ModuleDir)) {new-item $$ModuleDir -ItemType Directory -Force > $null};
irm https://raw.githubusercontent.com/RelayTechIT/PCBuild/refs/heads/main/PCBuild-Module -OutFile "$($ModuleDir)\$($ModuleName).psm1"
Import-Module -Name $ModuleName -Force -Verbose

PCBuild-CheckForModuleOrPackage -PackageOrModuleName "NuGet" -PackageOrModuleType PackageProvider
PCBuild-CheckForModuleOrPackage -PackageOrModuleName "Microsoft.WinGet.Client" -PackageOrModuleType Module
PCBuild-CheckForModuleOrPackage -PackageOrModuleName "PSWindowsUpdate" -PackageOrModuleType Module
